generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FortuneProfile {
  id         String   @id @default(cuid())
  name       String?
  gender     String
  birthDate  String
  birthTime  String
  birthPlace String?
  longitude  Float?
  latitude   Float?
  timezone   String
  createdAt  DateTime @default(now())
  reports    FortuneReport[]
}

model FortuneReport {
  id               String   @id @default(cuid())
  profileId        String?
  profile          FortuneProfile? @relation(fields: [profileId], references: [id])
  type             String
  inputData        String
  algorithmResult  String
  calculationSteps String
  aiReport         String?
  warnings         String?
  createdAt        DateTime @default(now())
}

model TarotReading {
  id              String   @id @default(cuid())
  question        String?
  spreadType      String
  cards           String
  algorithmResult String
  aiReport        String?
  createdAt       DateTime @default(now())
}
